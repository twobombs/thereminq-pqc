# pqc-web-ingress TLS profiles: single source of truth.
# Read by lib/profile.sh (container entrypoints, pqc-eval) and by bin/pqc-webconf (Python).
# Format: plain KEY="value" lines, no shell expansion. Not meant to be sourced directly.
# Group and sigalg lists in a profile reference HYBRID / CLASSIC / PQC above, joined in order.
#
# Names are OpenSSL 3.5 names. Hybrid groups combine a classical ECDH share with ML-KEM;
# the connection stays confidential if either half holds.

# Key exchange groups
PQC_GROUPS_HYBRID="X25519MLKEM768:SecP256r1MLKEM768:SecP384r1MLKEM1024"
PQC_GROUPS_CLASSIC="X25519:P-256:P-384"

# TLS 1.3 signature algorithms used for certificate selection
PQC_SIGALGS_PQC="mldsa65:mldsa87:mldsa44"
PQC_SIGALGS_CLASSIC="ecdsa_secp256r1_sha256:ecdsa_secp384r1_sha384:ecdsa_secp521r1_sha512:ed25519:rsa_pss_rsae_sha256:rsa_pss_rsae_sha384:rsa_pss_rsae_sha512:rsa_pss_pss_sha256:rsa_pss_pss_sha384:rsa_pss_pss_sha512:rsa_pkcs1_sha256:rsa_pkcs1_sha384:rsa_pkcs1_sha512"

# compat: classical chain first. ML-DSA chain only for clients that offer ML-DSA and nothing classical.
compat_PROTOCOLS="TLSv1.2 TLSv1.3"
compat_GROUPS="HYBRID:CLASSIC"
compat_SIGALGS="CLASSIC:PQC"
compat_CLASSIC_CERT="yes"

# pqc-first: ML-DSA chain for every client that offers ML-DSA, classical chain for the rest.
pqc-first_PROTOCOLS="TLSv1.2 TLSv1.3"
pqc-first_GROUPS="HYBRID:CLASSIC"
pqc-first_SIGALGS="PQC:CLASSIC"
pqc-first_CLASSIC_CERT="yes"

# pqc-only: TLS 1.3, hybrid key exchange, ML-DSA chain. Classical-only clients fail the handshake.
pqc-only_PROTOCOLS="TLSv1.3"
pqc-only_GROUPS="HYBRID"
pqc-only_SIGALGS="PQC"
pqc-only_CLASSIC_CERT="no"
