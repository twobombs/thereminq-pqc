# Copy to .env and pin everything before a production build.

# Base image, pin by digest: debian:trixie-slim@sha256:<digest>
DEBIAN_IMAGE=debian:trixie-slim
RUST_IMAGE=rust:slim-trixie

# Source pins (builds refuse to start without them)
ROSENPASS_VERSION=v0.2.2
MERLIN_REF=main                  # replace with a kontext-security/merlin commit hash
LLAMA_CPP_REF=                   # llama.cpp release tag, e.g. bNNNN
TORCH_VERSION=2.9.0
# UI base, pin by digest after importing via the quarantine host:
# twobombs/thereminq-tensors:jupyter@sha256:<digest>
THEREMINQ_JUPYTER_IMAGE=

# Runtime
WF_PUBLIC_IF=eth0
WF_WG_ADDR=10.77.0.1/24
WF_RP_PORT=9999
WF_FORWARD_IF=wf-ui             # lets tunnel traffic reach ui-door, nothing else
WF_UI_BIND=10.77.0.1             # WireGuard address; UI ports are published only here
WF_UI_MEM=32g
RENDER_GID=                      # getent group render | cut -d: -f3
VIDEO_GID=44                     # getent group video | cut -d: -f3
WF_CTX=8192
WF_GPU_LAYERS=999
